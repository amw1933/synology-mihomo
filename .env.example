# ============================================================================
#  群晖 mihomo —— 单端口 / 旁路由 版的环境变量（可选）
#  复制成 .env 后按需修改；不建 .env 也能跑（全部用默认值）
# ============================================================================

# 管理台密码（首次登录用；登录后请在管理台里立刻改掉）
ADMIN_PASS=admin

# 唯一对外端口：管理台 / + 节点面板 /ui/ + 内核接口反代 /clash/
ADMIN_PORT=9090
ADMIN_BIND=0.0.0.0

# 代理端口（host 网络下 = 配置里的 mixed-port；只有 App 手填代理时才用到）
PROXY_PORT=7890

# 内核控制接口端口（只绑 127.0.0.1，不对外，通常不用改）
PANEL_PORT=9091

# 1 = 旁路由（TUN，默认）；0 = 只开代理端口、不改路由
TUN_ENABLE=1

# 容器名（同一台机器上装第二套时改这两个，避免撞名）
CT_MH=mihomo
CT_ADMIN=mihomo-admin
